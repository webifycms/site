{
	"name": "webifycms/site",
	"description": "WebifyCMS site",
	"license": "MIT",
	"keywords": [
		"webify",
		"webifycms",
		"webifycms.com"
	],
	"homepage": "https://www.webifycms.com/",
	"type": "project",
	"support": {
		"issues": "https://github.com/webifycms/app/issues?state=open",
		"source": "https://github.com/webifycms/app"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": ">=8.4",
		"webifycms/ext-base": "^0.1.0-alpha",
		"league/commonmark": "^2.8",
		"symfony/yaml": "^8.1",
		"symfony/validator": "^7.0",
		"symfony/property-access": "^7.0",
		"symfony/property-info": "^7.0",
		"psr/http-client": "^1.0",
		"guzzlehttp/guzzle": "^7.14",
		"sentry/sentry": "^4.0"
	},
	"require-dev": {
		"webifycms/dev-tools": "^1.3",
		"phpunit/phpunit": "^13.1",
		"fakerphp/faker": "^1.24",
		"phpat/phpat": "^0.12",
		"filp/whoops": "^2.18",
		"roave/security-advisories": "dev-latest"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"optimize-autoloader": true,
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Test\\": "test/",
			"App\\Dev\\": "dev/"
		}
	},
	"scripts": {
		"sniff": [
			"php-cs-fixer fix --config=tools/.php-cs-fixer.dist.php --verbose --dry-run --diff --show-progress=dots"
		],
		"analyse": [
			"phpstan analyse -c tools/phpstan.dist.neon"
		],
		"phpcs": [
			"phpcs --standard=tools/phpcs.xml -p src test"
		],
		"test": [
			"phpunit -c tools/phpunit.dist.xml"
		],
		"code-check": [
			"@analyse",
			"@sniff",
			"@phpcs"
		],
		"code-format": [
			"php-cs-fixer fix --config=tools/.php-cs-fixer.dist.php --verbose --show-progress=dots"
		]
	},
	"config": {
		"platform-check": false
	}
}
