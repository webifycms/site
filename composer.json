{
  "name": "webifycms/site",
  "description": "WebifyCMS site",
  "license": "MIT",
  "keywords": [
    "webify",
    "webifycms",
    "webifycms.com"
  ],
  "homepage": "https://www.webifycms.com/",
  "type": "project",
  "support": {
    "issues": "https://github.com/webifycms/app/issues?state=open",
    "source": "https://github.com/webifycms/app"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "webifycms/ext-base": "^0.1.0-alpha",
    "league/commonmark": "^2.8",
    "symfony/yaml": "^8.1",
    "symfony/validator": "^7.0",
    "symfony/property-access": "^7.0",
    "symfony/property-info": "^7.0",
    "psr/http-client": "^1.0",
    "guzzlehttp/guzzle": "^7.14",
    "sentry/sentry": "^4.0"
  },
  "require-dev": {
    "webifycms/dev-tools": "^1.0",
    "phpunit/phpunit": "^13.1",
    "fakerphp/faker": "^1.24",
    "phpat/phpat": "^0.12",
    "filp/whoops": "^2.18",
    "roave/security-advisories": "dev-latest"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "optimize-autoloader": true,
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Test\\": "test/",
      "App\\Dev\\": "dev/"
    }
  },
  "scripts": {
    "analyse": [
      "phpstan"
    ],
    "sniff": [
      "php-cs-fixer fix --config=.php-cs-fixer.dist.php --show-progress=dots --diff --dry-run"
    ],
    "test": [
      "phpunit test"
    ],
    "code-check": [
      "@analyse",
      "@sniff"
    ],
    "code-format": [
      "php-cs-fixer fix --config=.php-cs-fixer.dist.php --show-progress=dots"
    ]
  },
  "config": {
    "platform-check": false
  }
}
