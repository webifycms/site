# app info
APP_NAME=WebifyCMS
APP_ID=webifycms
APP_VERSION=0.1.0
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=http://localhost

# NGINX (internal port 80, mapped to host port 3000 for Caddy reverse proxy)
NGINX_PORT=3000

# Vite
VITE_PORT=5173
VITE_HOST=0.0.0.0
VITE_BASE_URL=/
VITE_DEV_SERVER_URL=http://localhost:5173

# Mailing list
MAIL_LIST_URL=https://localhost:9000
MAIL_LIST_API_KEY=the_api_key

# Analytics
ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
ANALYTICS_WEBSITE_ID=your-website-id

# Error tracking
ERROR_TRACKING_DSN=
